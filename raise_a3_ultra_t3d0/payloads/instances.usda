#usda 1.0
(
    doc = """Instances layer (Structure 3.0).
Visual (+ collider geom) assemblies referencing geometries.usd.
Collision APIs live in Physics layers as overs on /agibot_a3/.../colliders/collider."""
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "pelvis_link"
    {
        def Mesh "visuals" (
            prepend references = @./geometries.usd@</Geometries/pelvis_link_visuals>
        )
        {
            token visibility = "inherited"
        }

        def Mesh "collider" (
            delete apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxConvexHullCollisionAPI", "PhysicsMeshCollisionAPI"]
            prepend references = @./geometries.usd@</Geometries/pelvis_link_visuals>
        )
        {
            uniform token purpose = "guide"
        }
    }

