    def Xform "pelvis_link" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom int physxArticulation:solverPositionIterationCount = 32
        custom int physxArticulation:solverVelocityIterationCount = 1

        def PhysicsRevoluteJoint "left_hip_pitch_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            custom float physxJoint:jointFriction = 0
            custom float physxJoint:maxJointVelocity = 690
        }

        def PhysicsRevoluteJoint "right_hip_pitch_joint" (
