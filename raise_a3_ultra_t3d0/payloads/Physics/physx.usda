#usda 1.0
(
    defaultPrim = "agibot_a3"
    doc = """PhysX physics layer (Structure 3.0).
Sublayers physics.usda and adds PhysX-specific APIs/attributes."""
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

