#usda 1.0
(
    defaultPrim = "agibot_a3"
    doc = """Isaac Robot Schema layer (Structure 3.0 / Isaac Sim 6.0.1).

Applies IsaacRobotAPI / IsaacLinkAPI / IsaacJointAPI / IsaacSiteAPI.
Compose as a sublayer of the interface asset; physics/geometry remain in base.usda.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

